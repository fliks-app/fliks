<?xml version="1.0" encoding="utf-8"?>
<!--
  Override of Capacitor's default bridge layout. We add
  android:background="?attr/splashBackground" so the WebView is painted in the
  active theme's colour from frame 0 — Capacitor's default has no background
  and the WebView falls back to white, which leaks as a flash between the
  native splash and the first Angular paint.

  setTheme() in MainActivity.applyThemedSplash() runs before super.onCreate()
  inflates this layout, so ?attr/splashBackground resolves to the right
  variant (Dark or Light) per the persisted Fliks theme.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/splashBackground"
    tools:context="com.getcapacitor.BridgeActivity">

    <com.getcapacitor.CapacitorWebView
        android:id="@+id/webview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="?attr/splashBackground" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
