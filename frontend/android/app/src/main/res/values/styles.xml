<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- Launch theme (Android ≤ 11) — traditional `windowBackground`
         splash. Theme.SplashScreen's AndroidX compat layer was
         showing the launcher icon scaled to fill on Android TV 11
         instead of honouring our splash_themed drawable; on a regular
         AppCompat parent the system just paints windowBackground until
         the activity's first frame, which is exactly what we want.
         Theme.SplashScreen is kept for Android 12+ via values-v31/. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/splash_themed</item>
        <item name="splashBackground">@color/splash_bg_dark</item>
    </style>
</resources>
