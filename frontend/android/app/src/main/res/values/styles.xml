<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- Base launch theme. The drawable reads ?attr/splashBackground from the
         active variant (Dark or Light below). Default = Dark to match the
         legacy behaviour for users who haven't picked a theme yet.

         We set both android:background (legacy) and android:windowBackground
         (modern, what the OS actually paints for the splash window) so the
         theme is robust across Android versions. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash_themed</item>
        <item name="android:windowBackground">@drawable/splash_themed</item>
        <item name="splashBackground">@color/splash_bg_dark</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Dark">
        <item name="splashBackground">@color/splash_bg_dark</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Light">
        <item name="splashBackground">@color/splash_bg_light</item>
    </style>
</resources>