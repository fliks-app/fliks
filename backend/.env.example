# En local hors Docker : localhost + port mappé (ex. 5434).
# Avec docker-compose à la racine du repo : surcharger via compose (DB_HOST=postgres, DB_PORT=5432).
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=fliks
DB_PASSWORD=fliks
DB_NAME=fliks

JWT_SECRET=change-me-in-production
JWT_EXPIRATION=7d

TMDB_API_KEY=your-tmdb-api-key-here
TVDB_API_KEY=your-tvdb-api-key-here

# Métadonnées considérées comme « à rafraîchir » si plus anciennes que N mois (commande métadonnées manquantes).
METADATA_STALE_AFTER_MONTHS=3

PORT=3001

# Origines web (navigateur) pour CORS + cookies. Séparer par des virgules.
# Les apps Capacitor (https://localhost, capacitor://localhost, …) sont toujours ajoutées côté serveur.
CORS_ORIGIN=http://localhost:4500
