# En local hors Docker : localhost + port mappé (ex. 5434).
# Avec docker-compose à la racine du repo : surcharger via compose (DB_HOST=postgres, DB_PORT=5432).
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=suitarr
DB_PASSWORD=suitarr
DB_NAME=suitarr

JWT_SECRET=change-me-in-production
JWT_EXPIRATION=7d

TMDB_API_KEY=your-tmdb-api-key-here

PORT=3001

# Origines autorisées pour les cookies (CORS). Séparer par des virgules.
CORS_ORIGIN=http://localhost:4500
