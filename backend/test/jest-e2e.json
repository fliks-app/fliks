{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "node_modules/@svta/.+\\.js$": [
      "ts-jest",
      { "tsconfig": { "allowJs": true, "module": "commonjs", "target": "ES2022" } }
    ]
  },
  "transformIgnorePatterns": ["/node_modules/(?!@svta/)"]
}
