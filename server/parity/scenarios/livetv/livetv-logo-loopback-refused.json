{
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..lastSyncAt"
  ],
  "name": "livetv-logo-loopback-refused",
  "seed": "livetv",
  "steps": [
    {
      "as": "user",
      "expect": {
        "body": {
          "message": "Not Found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "GET",
      "path": "/api/livetv/channels/1/logo"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "added": 1,
          "channelCount": 5,
          "ok": true,
          "removed": 3,
          "updated": 4
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/livetv/admin/sources/1/sync"
    },
    {
      "as": "anon",
      "expect": {
        "status": 200
      },
      "wait": "idle"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "message": "Not Found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "GET",
      "path": "/api/livetv/channels/1/logo"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "message": "Not Found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "GET",
      "path": "/api/livetv/channels/1/logo?size=thumb"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "message": "Not Found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "GET",
      "path": "/api/livetv/channels/1/logo?size=huge"
    },
    {
      "as": "user",
      "expect": {
        "body": [
          {
            "favorite": true,
            "groupName": "Mine",
            "guideChannelId": "two.fr",
            "id": 2,
            "logoPath": null,
            "name": "Two",
            "number": 2
          },
          {
            "favorite": false,
            "groupName": "News",
            "guideChannelId": "one.fr",
            "id": 1,
            "logoPath": null,
            "name": "One",
            "number": 1
          },
          {
            "favorite": false,
            "groupName": "__livetv_ungrouped__",
            "guideChannelId": null,
            "id": 4,
            "logoPath": null,
            "name": "No Group",
            "number": null
          }
        ],
        "status": 200
      },
      "method": "GET",
      "path": "/api/livetv/channels"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Live TV channel #99 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "GET",
      "path": "/api/livetv/channels/99/logo"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Validation failed (numeric string is expected)",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "GET",
      "path": "/api/livetv/channels/abc/logo"
    }
  ]
}
