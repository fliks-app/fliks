{
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..lastSyncAt",
    "$..logoPath"
  ],
  "name": "livetv-admin-channels-patch-404",
  "seed": "livetv",
  "steps": [
    {
      "as": "admin",
      "body": {
        "name": "x"
      },
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Live TV channel #99 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "PATCH",
      "path": "/api/livetv/admin/channels/99"
    },
    {
      "as": "admin",
      "body": {
        "name": "x"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Validation failed (numeric string is expected)",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PATCH",
      "path": "/api/livetv/admin/channels/abc"
    },
    {
      "as": "admin",
      "body": {
        "extra": 1,
        "name": 1,
        "number": "x"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "property extra should not exist",
            "name must be a string",
            "number must be an integer number"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PATCH",
      "path": "/api/livetv/admin/channels/1"
    }
  ]
}
