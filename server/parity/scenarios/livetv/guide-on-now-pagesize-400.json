{
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..lastSyncAt",
    "$..logoPath"
  ],
  "name": "guide-on-now-pagesize-400",
  "seed": "livetv",
  "steps": [
    {
      "as": "user",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "pageSize must not be greater than 50"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "GET",
      "path": "/api/livetv/channels/on-now?pageSize=51"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "pageSize must not be less than 1"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "GET",
      "path": "/api/livetv/channels/on-now?pageSize=0"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "page must not be less than 1"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "GET",
      "path": "/api/livetv/channels/on-now?page=0"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "query must be shorter than or equal to 200 characters"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "GET",
      "path": "/api/livetv/channels/on-now?query=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "property unknown should not exist"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "GET",
      "path": "/api/livetv/channels/on-now?unknown=1"
    }
  ]
}
