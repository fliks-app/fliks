{
  "capture": {
    "loc": "$.steps[0].body.location"
  },
  "deviation": null,
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..lastSyncAt",
    "$..logoPath",
    "$..location",
    "$..url"
  ],
  "name": "sources-playlist-upload",
  "seed": "base",
  "steps": [
    {
      "as": "admin",
      "expect": {
        "body": {},
        "status": 201
      },
      "method": "POST",
      "multipart": {
        "contentType": "audio/mpegurl",
        "field": "file",
        "file": "s7/playlist.m3u",
        "filename": "My List (1).m3u"
      },
      "path": "/api/livetv/admin/sources/playlist"
    },
    {
      "as": "admin",
      "body": {
        "kind": "m3u",
        "url": "{loc}"
      },
      "expect": {
        "body": {
          "accountStatus": null,
          "channelCount": 5,
          "expiresAt": null,
          "groups": [
            {
              "count": 2,
              "name": "News"
            },
            {
              "count": 1,
              "name": "Sport"
            },
            {
              "count": 1,
              "name": "Movies"
            },
            {
              "count": 1,
              "name": "__livetv_ungrouped__"
            }
          ],
          "guideUrl": "http://127.0.0.1:4921/guide.xml",
          "guideUrls": [
            "http://127.0.0.1:4921/guide.xml"
          ],
          "kind": "m3u",
          "maxConnections": 2,
          "ok": true,
          "onDemandCount": 2,
          "playlistUrlFromFile": "http://127.0.0.1:4921/get.php?username=u&password=p&type=m3u_plus&output=ts",
          "suggestion": {
            "baseUrl": "http://127.0.0.1:4921",
            "password": "p",
            "suggestedKind": "xtream",
            "username": "u"
          }
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/livetv/admin/sources/test"
    },
    {
      "as": "admin",
      "body": {
        "excludeGroupsPattern": "x",
        "includeGroupsPattern": "^news$",
        "kind": "m3u",
        "url": "{loc}"
      },
      "expect": {
        "body": {
          "accountStatus": null,
          "channelCount": 2,
          "expiresAt": null,
          "groups": [
            {
              "count": 2,
              "name": "News"
            },
            {
              "count": 1,
              "name": "Sport"
            },
            {
              "count": 1,
              "name": "Movies"
            },
            {
              "count": 1,
              "name": "__livetv_ungrouped__"
            }
          ],
          "guideUrl": "http://127.0.0.1:4921/guide.xml",
