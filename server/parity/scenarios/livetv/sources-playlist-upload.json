        "status": 201
      },
      "ignore": [
        "$.error"
      ],
      "method": "POST",
      "path": "/api/livetv/admin/sources/test"
    },
    {
      "as": "admin",
      "body": {
        "kind": "m3u",
        "name": "Up",
