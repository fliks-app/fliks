            "http://127.0.0.1:4921/guide.xml"
          ],
          "kind": "m3u",
          "maxConnections": 2,
          "ok": true,
          "onDemandCount": 2,
          "playlistUrlFromFile": "http://127.0.0.1:4921/get.php?username=u&password=p&type=m3u_plus&output=ts",
          "suggestion": {
            "baseUrl": "http://127.0.0.1:4921",
            "password": "p",
            "suggestedKind": "xtream",
            "username": "u"
          }
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/livetv/admin/sources/test"
    },
    {
      "as": "admin",
      "body": {
        "includeGroupsPattern": "(",
        "kind": "m3u",
        "url": "{loc}"
      },
      "expect": {
        "body": {
          "accountStatus": null,
          "channelCount": 0,
          "expiresAt": null,
          "groups": [],
