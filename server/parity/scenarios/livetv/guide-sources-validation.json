{
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..lastSyncAt",
    "$..logoPath"
  ],
  "name": "guide-sources-validation",
  "seed": "livetv",
  "steps": [
    {
      "as": "admin",
      "body": {},
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "name must be a string",
            "kind must be one of the following values: xmltv, source"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/livetv/admin/guide-sources"
    },
    {
      "as": "admin",
      "body": {
        "enabled": 1,
        "extra": 1,
        "kind": "x",
        "name": 1,
        "sourceId": "a",
        "url": "nope"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "property extra should not exist",
            "name must be a string",
            "kind must be one of the following values: xmltv, source",
            "url must be a URL address",
            "sourceId must be an integer number",
            "enabled must be a boolean value"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/livetv/admin/guide-sources"
    },
    {
      "as": "admin",
      "body": {
        "kind": "xmltv",
        "name": "n",
        "url": "/local/file.xml"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "url must be a URL address"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/livetv/admin/guide-sources"
    },
    {
      "as": "admin",
      "body": {
        "kind": "x",
        "priority": "1"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "kind must be one of the following values: xmltv, source",
            "priority must be an integer number"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PATCH",
      "path": "/api/livetv/admin/guide-sources/1"
    },
    {
      "as": "admin",
      "body": {
        "url": 5
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "url must be a string"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PATCH",
      "path": "/api/livetv/admin/guide-sources/1"
    },
    {
      "as": "admin",
      "body": {},
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Validation failed (numeric string is expected)",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PATCH",
      "path": "/api/livetv/admin/guide-sources/abc"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Validation failed (numeric string is expected)",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "DELETE",
      "path": "/api/livetv/admin/guide-sources/abc"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Validation failed (numeric string is expected)",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/livetv/admin/guide-sources/abc/sync"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Guide source #99 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "POST",
      "path": "/api/livetv/admin/guide-sources/99/sync"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "guideSourceId must not be less than 1"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "GET",
      "path": "/api/livetv/admin/guide/match-report?guideSourceId=0"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "guideSourceId must not be less than 1",
            "guideSourceId must be an integer number"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "GET",
      "path": "/api/livetv/admin/guide/match-report?guideSourceId=x"
    }
  ]
}
