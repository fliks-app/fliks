{
  "deviation": "C130",
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..lastSyncAt",
    "$..logoPath",
    "$..startedOn",
    "$..endedOn",
    "$..id"
  ],
  "name": "guide-sync-409",
  "seed": "livetv",
  "steps": [
    {
      "as": "anon",
      "baseEnv": "PARITY_LIVETV",
      "body": {
        "delay": 2.5
      },
      "expect": {
        "body": {
          "delay": 2.5,
          "shrunk": false
        },
        "status": 200
      },
      "method": "POST",
      "path": "/_mode"
    },
    {
      "as": "admin",
      "body": {
        "name": "LiveTvGuideRefresh"
      },
      "expect": {
        "body": {
          "body": null,
          "name": "LiveTvGuideRefresh",
          "status": "queued",
          "trigger": "manual"
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/commands"
    },
    {
      "as": "anon",
      "wait": "busy",
      "expect": {
        "status": 200
      },
      "note": "needs the fixture delay set above: without it the sync can finish before this wait sees it busy"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Conflict",
          "message": "errors.already_running",
          "statusCode": 409
        },
        "status": 409
      },
      "method": "POST",
      "path": "/api/livetv/admin/guide-sources/1/sync"
    },
    {
      "as": "anon",
      "wait": "idle",
      "expect": {
        "status": 200
      }
    },
    {
      "as": "anon",
      "baseEnv": "PARITY_LIVETV",
      "body": {},
      "expect": {
        "body": {
          "delay": 0.0,
          "shrunk": false
        },
        "status": 200
      },
      "method": "POST",
      "path": "/_mode"
    }
  ]
}
