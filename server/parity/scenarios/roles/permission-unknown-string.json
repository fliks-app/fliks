{
  "deviation": "F12",
  "ignore": [
    "$..createdAt",
    "$..updatedAt"
  ],
  "name": "roles-permission-unknown-string",
  "seed": "base",
  "steps": [
    {
      "as": "admin",
      "body": {
        "permissions": [
          "media.read",
          "users.manage",
          "roles.manage"
        ]
      },
      "expect": {
        "body": {
          "defaultLibraries": [],
          "defaultLibraryIds": [],
          "id": 4,
          "isDefault": false,
          "name": "Manager",
          "permissions": [
            "media.read",
            "users.manage",
            "roles.manage"
          ]
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/roles/4"
    },
    {
      "as": "manager",
      "body": {
        "name": "Bogus",
        "permissions": [
          "not.a.permission"
        ]
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/roles"
    },
    {
      "as": "manager",
      "body": {
        "permissions": [
          "media.read",
          "not.a.permission"
        ]
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PUT",
      "path": "/api/roles/3"
    }
  ]
}
