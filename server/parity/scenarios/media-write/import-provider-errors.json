{
  "deviation": null,
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..metadataRefreshedAt"
  ],
  "name": "media-write-import-provider-errors",
  "seed": "ingest",
  "steps": [
    {
      "as": "admin",
      "body": {
        "externalId": "5101",
        "provider": "tmdb",
        "type": "movie"
      },
      "expect": {
        "body": {
          "error": "Conflict",
          "message": "This title is already in the library",
          "statusCode": 409
        },
        "status": 409
      },
      "method": "POST",
      "path": "/api/media/import"
    },
    {
      "as": "admin",
      "body": {
        "externalId": "777",
        "libraryId": 99,
        "type": "movie"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Library #99 not found",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/media/import"
    },
    {
      "as": "admin",
      "body": {
        "externalId": "777",
        "libraryId": 3,
        "type": "series"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Library \"Work Movies\" does not accept series",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/media/import"
    },
    {
      "as": "admin",
      "body": {
        "externalId": "777",
        "libraryId": 3,
        "qualityProfileId": 42,
        "type": "movie"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Quality profile #42 not found",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/media/import"
    },
    {
      "as": "admin",
      "body": {
        "externalId": "777",
        "type": "movie"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Several libraries accept movie — pass libraryId to choose one",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/media/import"
    },
    {
      "as": "admin",
      "body": {
        "externalId": "777",
        "libraryId": 5,
        "type": "movie"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Library \"Pathless\" has no root path configured",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/media/import"
    },
    {
      "as": "user",
      "body": {
        "externalId": "777",
        "type": "movie"
      },
      "expect": {
        "body": {
          "error": "Forbidden",
          "message": "Forbidden resource",
          "statusCode": 403
        },
        "status": 403
      },
      "method": "POST",
      "path": "/api/media/import"
    }
  ]
}
