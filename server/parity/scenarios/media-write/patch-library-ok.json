{
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..metadataRefreshedAt"
  ],
  "name": "media-write-patch-library-ok",
  "seed": "ingest",
  "steps": [
    {
      "as": "admin",
      "body": {
        "libraryId": 1
      },
      "expect": {
        "body": {
          "code": "media_has_files",
          "error": "Conflict",
          "message": "This media has files and cannot be moved to another library",
          "statusCode": 409
        },
        "status": 409
      },
      "method": "PATCH",
      "path": "/api/media/104/library"
    },
    {
      "as": "admin",
      "body": {
        "libraryId": 5
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Library \"Pathless\" has no root path configured",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PATCH",
      "path": "/api/media/104/library"
    },
    {
      "as": "admin",
      "body": {
        "libraryId": 99
      },
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Library #99 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "PATCH",
      "path": "/api/media/104/library"
    },
    {
      "as": "user",
      "body": {
        "libraryId": 1
      },
      "expect": {
        "body": {
          "error": "Forbidden",
          "message": "Forbidden resource",
          "statusCode": 403
        },
        "status": 403
      },
      "method": "PATCH",
      "path": "/api/media/104/library"
    }
  ]
}
