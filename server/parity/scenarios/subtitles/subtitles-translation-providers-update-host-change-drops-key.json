{
  "deviation": null,
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..date",
    "$..queuedAt"
  ],
  "name": "subtitles-translation-providers-update-host-change-drops-key",
  "seed": "subtitles",
  "steps": [
    {
      "as": "admin",
      "body": {
        "settings": {
          "baseUrl": "http://other.example/v1",
          "model": "m"
        }
      },
      "expect": {
        "body": {
          "enabled": true,
          "engine": "openai",
          "id": 2,
          "isDefault": false,
          "name": "Local",
          "settings": {
            "baseUrl": "http://other.example/v1",
            "model": "m",
            "secretsSet": []
          }
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/subtitles/translation-providers/2"
    },
    {
      "as": "admin",
      "body": {
        "settings": {
          "apiKey": "new",
          "baseUrl": "http://other.example/v1",
          "model": "m2"
        }
      },
      "expect": {
        "body": {
          "enabled": true,
          "engine": "openai",
          "id": 2,
          "isDefault": false,
          "name": "Local",
          "settings": {
            "baseUrl": "http://other.example/v1",
            "model": "m2",
            "secretsSet": [
              "apiKey"
            ]
          }
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/subtitles/translation-providers/2"
    }
  ],
  "strictMessage": true
}
