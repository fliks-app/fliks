{
  "deviation": null,
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..date",
    "$..queuedAt"
  ],
  "name": "subtitles-translation-providers-create-validation-400",
  "seed": "subtitles",
  "steps": [
    {
      "as": "admin",
      "body": {
        "engine": "nope",
        "name": "x"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "engine must be one of the following values: gemini, openai, libretranslate"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/subtitles/translation-providers"
    },
    {
      "as": "admin",
      "body": {
        "engine": "gemini"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "name must be a string"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/subtitles/translation-providers"
    },
    {
      "as": "admin",
      "body": {
        "engine": "gemini",
        "name": "x",
        "settings": [
          1
        ]
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "settings must be an object"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/subtitles/translation-providers"
    },
    {
      "as": "user",
      "body": {
        "engine": "gemini",
        "name": "x"
      },
      "expect": {
        "body": {
          "error": "Forbidden",
          "message": "Forbidden resource",
          "statusCode": 403
        },
        "status": 403
      },
      "method": "POST",
      "path": "/api/subtitles/translation-providers"
    }
  ],
  "strictMessage": true
}
