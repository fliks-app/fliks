{
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..lastLogin",
    "$..lastActiveAt",
    "$..lastPlayedAt",
    "$..playedAt"
  ],
  "name": "likes-validation",
  "seed": "base",
  "steps": [
    {
      "as": "user",
      "body": {},
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "mediaId must be an integer number"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/likes"
    },
    {
      "as": "user",
      "body": {
        "mediaId": "x"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "mediaId must be an integer number"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/likes"
    },
    {
      "as": "user",
      "body": {
        "extra": 1,
        "mediaId": 1
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "property extra should not exist"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/likes"
    },
    {
      "as": "user",
      "body": {
        "mediaId": 1.5
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "mediaId must be an integer number"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/likes"
    },
    {
      "as": "user",
      "body": {
        "mediaId": 1,
        "seasonId": "a"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "seasonId must be an integer number"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/likes"
    },
    {
      "as": "user",
      "body": {},
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "mediaId must be an integer number"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "DELETE",
      "path": "/api/likes"
    }
  ]
}
