{
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..connectionId"
  ],
  "name": "media-servers-import-concurrent",
  "seed": "media-servers",
  "steps": [
    {
      "as": "admin",
      "method": "GET",
      "path": "/api/system/events?device=ms",
      "expect": {
        "status": 200,
        "body": [
          {
            "data": {
              "type": "sse.connected"
            },
            "event": ""
          },
          {
            "data": {
              "serverId": 6,
              "serverName": "Emby Slow",
              "type": "watch-history.import.started"
            },
            "event": ""
          },
          {
            "data": {
              "name": "ImportWatchHistory",
              "type": "command.started"
            },
            "event": ""
          }
        ]
      },
      "sse": {
        "events": 3,
        "timeoutMs": 8000,
        "after": [
          {
            "as": "admin",
            "expect": {
              "status": 201,
              "body": {
                "ok": true
              }
            },
            "method": "POST",
            "path": "/api/media-servers/6/import-watch-history"
          }
        ]
      }
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Conflict",
          "message": "Import already running",
          "statusCode": 409
        },
        "status": 409
      },
      "method": "POST",
      "path": "/api/media-servers/6/import-watch-history"
    },
    {
      "as": "admin",
      "expect": {
        "body": [
          {
            "data": {
              "type": "sse.connected"
            },
            "event": ""
          },
          {
            "data": {
              "imported": 6,
              "serverId": 6,
              "serverName": "Emby Slow",
              "skipped": 6,
              "type": "watch-history.import.completed",
              "users": 2,
              "usersCreated": 1
            },
            "event": ""
          },
          {
            "data": {
              "name": "ImportWatchHistory",
              "status": "completed",
              "type": "command.completed"
            },
            "event": ""
          }
        ],
        "status": 200
      },
      "method": "GET",
      "path": "/api/system/events?device=ms",
      "sse": {
        "events": 3,
        "timeoutMs": 15000
      }
    }
  ]
}
