{
  "ignore": [
    "$..createdAt",
    "$..updatedAt"
  ],
  "name": "media-servers-create-url-events-400",
  "seed": "media-servers",
  "steps": [
    {
      "as": "admin",
      "body": {
        "name": "n",
        "type": "emby",
        "url": "emby:8096"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "url must be a URL address"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/media-servers"
    },
    {
      "as": "admin",
      "body": {
        "name": "n",
        "type": "emby",
        "url": "ftp://emby"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "url must be a URL address"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/media-servers"
    },
    {
      "as": "admin",
      "body": {
        "events": [
          "nope"
        ],
        "name": "n",
        "type": "emby",
        "url": "http://emby"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "each value in events must be one of the following values: download.complete, subtitle.downloaded, subtitle.upgraded, subtitle.synced, file.deleted, media.deleted, library.rescan"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/media-servers"
    },
    {
      "as": "admin",
      "body": {
        "events": [
          "library.rescan"
        ],
        "name": "n",
        "type": "plex",
        "url": "http://plex"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "type plex supports no events"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/media-servers"
    }
  ]
}
