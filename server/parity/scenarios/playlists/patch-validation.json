{
  "deviation": null,
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..lastLogin",
    "$..lastActiveAt",
    "$..lastPlayedAt",
    "$..playedAt",
    "$..path"
  ],
  "name": "playlists-patch-validation",
  "seed": "base",
  "steps": [
    {
      "as": "user",
      "body": {
        "visibility": "secret"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "visibility must be one of the following values: private, followers, public"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PATCH",
      "path": "/api/playlists/1"
    },
    {
      "as": "user",
      "body": {
        "name": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "name must be shorter than or equal to 255 characters"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PATCH",
      "path": "/api/playlists/1"
    },
    {
      "as": "user",
      "body": {
        "extra": 1
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "property extra should not exist"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PATCH",
      "path": "/api/playlists/1"
    },
    {
      "as": "user",
      "body": {
        "autoPlay": "x"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "autoPlay must be a boolean value"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PATCH",
      "path": "/api/playlists/1"
    },
    {
      "as": "user",
      "body": {
        "name": "x"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Validation failed (numeric string is expected)",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PATCH",
      "path": "/api/playlists/abc"
    },
    {
      "as": "anon",
      "body": {
        "name": "x"
      },
      "expect": {
        "body": {
          "message": "Unauthorized",
          "statusCode": 401
        },
        "status": 401
      },
      "method": "PATCH",
      "path": "/api/playlists/1"
    }
  ]
}
