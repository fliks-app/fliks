{
  "deviation": null,
  "name": "remote-command-validation-level",
  "seed": "base",
  "steps": [
    {
      "as": "user",
      "body": {
        "deviceId": "dev-1",
        "formFactor": "tv",
        "name": "Living room"
      },
      "expect": {
        "body": {
          "targetId": "dev-1#native"
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/remote/register"
    },
    {
      "as": "user",
      "body": {
        "action": "volume",
        "level": 5
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "level must not be greater than 1"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/remote/dev-1%23native/command"
    }
  ]
}
