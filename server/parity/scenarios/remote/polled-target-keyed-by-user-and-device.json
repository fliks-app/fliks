{
  "deviation": "F14",
  "ignore": [
    "$..cmdId",
    "$..expiresAt"
  ],
  "name": "remote-polled-target-keyed-by-user-and-device",
  "seed": "base",
  "steps": [
    {
      "as": "user",
      "body": {
        "deviceId": "dev-1",
        "formFactor": "tv",
        "name": "Living room"
      },
      "expect": {
        "body": {
          "targetId": "dev-1#native"
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/remote/register"
    },
    {
      "as": "other",
      "body": {
        "deviceId": "dev-1",
        "formFactor": "tv",
        "name": "Bedroom"
      },
      "expect": {
        "body": {
          "targetId": "dev-1#native"
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/remote/register"
    },
    {
      "as": "user",
      "body": {
        "action": "play"
      },
      "expect": {
        "body": {},
        "status": 202
      },
      "method": "POST",
      "path": "/api/remote/dev-1%23native/command"
    },
    {
      "as": "other",
      "expect": {
        "body": [],
        "status": 200
      },
      "method": "GET",
      "path": "/api/remote/commands?targetId=dev-1%23native"
    },
    {
      "as": "user",
      "expect": {
        "body": [
          {
            "action": "play",
            "byTargetId": null,
            "type": "remote.command"
          }
        ],
        "status": 200
      },
      "method": "GET",
      "path": "/api/remote/commands?targetId=dev-1%23native"
    }
  ]
}
