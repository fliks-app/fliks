    },
    {
      "as": "user",
      "expect": {
        "status": 204
      },
      "method": "DELETE",
      "path": "/api/remote/register?deviceId=dev-1"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "remote.error_device_offline",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "GET",
      "path": "/api/remote/commands?targetId=dev-1%23native"
    }
  ]
}
