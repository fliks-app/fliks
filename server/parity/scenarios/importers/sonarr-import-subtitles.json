{
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..searchVector"
  ],
  "name": "imports-sonarr-import-subtitles",
  "seed": "importers",
  "steps": [
    {
      "as": "admin",
      "body": {
        "apiKey": "parity-key",
        "importSubtitles": true,
        "pathMappings": [
          {
            "localLibraryId": 2,
            "remotePath": "/data/tv"
          },
          {
            "ignore": true,
            "remotePath": "/data/ignored"
          }
        ],
        "targetLibraryId": 2,
        "url": "http://127.0.0.1:4960/sonarr/ok"
      },
      "expect": {
        "body": {
          "errors": [
            "Lost Show: no path mapping for \"/elsewhere/Lost Show\""
          ],
          "imported": 1,
          "qualityProfilesCreated": [
            "Remote HD"
          ],
          "rootFoldersCreated": [],
          "subtitlesImported": 0
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/imports/sonarr"
    }
  ]
}
