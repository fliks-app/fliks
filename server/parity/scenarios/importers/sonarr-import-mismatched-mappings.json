{
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..searchVector"
  ],
  "name": "imports-sonarr-import-mismatched-mappings",
  "seed": "importers",
  "steps": [
    {
      "as": "admin",
      "body": {
        "apiKey": "parity-key",
        "pathMappings": [
          {
            "localLibraryId": 1,
            "remotePath": "/data"
          },
          {
            "localLibraryId": 77,
            "remotePath": "/x"
          }
        ],
        "targetLibraryId": 2,
        "url": "http://127.0.0.1:4960/sonarr/ok"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Path mappings target a different library than the import (target #2, mappings: 1, 77)",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/imports/sonarr"
    }
  ]
}
