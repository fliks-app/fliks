{
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..searchVector"
  ],
  "name": "imports-radarr-import-twice",
  "seed": "importers",
  "steps": [
    {
      "as": "admin",
      "body": {
        "apiKey": "parity-key",
        "pathMappings": [
          {
            "localLibraryId": 1,
            "remotePath": "/data/movies"
          },
          {
            "ignore": true,
            "remotePath": "/data/ignored"
          }
        ],
        "targetLibraryId": 1,
        "url": "http://127.0.0.1:4960/radarr/ok"
      },
      "expect": {
        "body": {
          "errors": [
            "Lost Film: no path mapping for \"/elsewhere/Lost Film (2022)\"",
            "No Path: no path mapping for \"\""
          ],
          "imported": 1,
          "qualityProfilesCreated": [
            "Remote HD"
          ],
          "rootFoldersCreated": [],
          "subtitlesImported": 0
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/imports/radarr"
    }
  ]
}
