{
  "deviation": "C33",
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..searchVector"
  ],
  "name": "imports-sonarr-import-v3",
  "seed": "importers",
  "steps": [
    {
      "as": "admin",
      "body": {
        "apiKey": "parity-key",
        "pathMappings": [
          {
            "localLibraryId": 2,
            "remotePath": "/data/tv"
          }
        ],
        "targetLibraryId": 2,
        "url": "http://127.0.0.1:4880/sonarr/v3"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Sonarr v4 or later is required (the series list carries no tmdbId)",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/imports/sonarr"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Media #21 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "GET",
      "path": "/api/media/21"
    }
  ]
}
