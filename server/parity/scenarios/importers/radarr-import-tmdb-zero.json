{
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..searchVector"
  ],
  "name": "imports-radarr-import-tmdb-zero",
  "seed": "importers",
  "steps": [
    {
      "as": "admin",
      "body": {
        "apiKey": "parity-key",
        "pathMappings": [
          {
            "localLibraryId": 1,
            "remotePath": "/data/movies"
          },
          {
            "ignore": true,
            "remotePath": "/data/ignored"
          }
        ],
        "targetLibraryId": 1,
        "url": "http://127.0.0.1:4960/radarr/tmdb-zero"
      },
      "expect": {
        "body": {
          "errors": [
            "Zero Id: invalid tmdbId"
          ],
          "imported": 0,
          "qualityProfilesCreated": [
            "Remote HD"
          ],
          "rootFoldersCreated": [],
          "subtitlesImported": 0
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/imports/radarr"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Media #21 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "GET",
      "path": "/api/media/21"
    }
  ]
}
