{
  "deviation": null,
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..searchVector"
  ],
  "name": "imports-radarr-import-empty",
  "seed": "importers",
  "steps": [
    {
      "as": "admin",
      "body": {
        "apiKey": "parity-key",
        "pathMappings": [
          {
            "localLibraryId": 1,
            "remotePath": "/data/movies"
          },
          {
            "ignore": true,
            "remotePath": "/data/ignored"
          }
        ],
        "targetLibraryId": 1,
        "url": "http://127.0.0.1:4880/radarr/empty"
      },
      "expect": {
        "body": {
          "errors": [
            "No movies found in Radarr"
          ],
          "imported": 0,
          "qualityProfilesCreated": [],
          "rootFoldersCreated": []
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/imports/radarr"
    }
  ]
}
