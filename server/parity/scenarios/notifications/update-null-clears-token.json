{
  "capture": {
    "id": "$.steps[0].body.id"
  },
  "ignore": [
    "$..id",
    "$..createdAt",
    "$..updatedAt"
  ],
  "name": "notifications-update-null-clears-token",
  "seed": "base",
  "steps": [
    {
      "as": "admin",
      "body": {
        "events": [
          "request.created",
          "request.available"
        ],
        "name": "Phone",
        "settings": {
          "token": "tk-secret",
          "topic": "media",
          "url": "https://ntfy.example.test"
        },
        "type": "ntfy"
      },
      "expect": {
        "body": {
          "enabled": true,
          "events": [
            "request.created",
            "request.available"
          ],
          "name": "Phone",
          "settings": {
            "secretsSet": [
              "token"
            ],
            "topic": "media",
            "url": "https://ntfy.example.test"
          },
          "type": "ntfy"
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/notifications"
    },
    {
      "as": "admin",
      "body": {
        "name": "Phone",
        "settings": {
          "token": null,
          "url": "https://ntfy.example.test"
        },
        "type": "ntfy"
      },
      "expect": {
        "body": {
          "enabled": true,
          "events": [
            "request.created",
            "request.available"
          ],
          "name": "Phone",
          "settings": {
            "secretsSet": [],
            "url": "https://ntfy.example.test"
          },
          "type": "ntfy"
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/notifications/{id}"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "enabled": true,
          "events": [
            "request.created",
            "request.available"
          ],
          "name": "Phone",
          "settings": {
            "secretsSet": [],
            "url": "https://ntfy.example.test"
          },
          "type": "ntfy"
        },
        "status": 200
      },
      "method": "GET",
      "path": "/api/notifications/{id}"
    }
  ],
  "strictMessage": true
}
