  "name": "notifications-create-webhook-legacy-url",
  "seed": "base",
  "steps": [
    {
      "as": "admin",
      "body": {
        "enabled": false,
        "name": "Hook",
        "settings": {
          "token": " t ",
          "webhookUrl": "  https://hook.example.test/in  "
        },
        "type": "webhook"
      },
      "expect": {
        "body": {
          "enabled": false,
          "events": [],
          "name": "Hook",
          "settings": {
            "secretsSet": [
              "token"
            ],
            "url": "https://hook.example.test/in"
          },
          "type": "webhook"
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/notifications"
    },
    {
      "as": "admin",
