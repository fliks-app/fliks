        "events": [
          "download.complete"
        ],
        "name": "Gotify",
        "settings": {
          "token": "g",
          "url": "https://gotify.example.test/"
        },
        "type": "gotify"
      },
      "expect": {
        "body": {
          "enabled": true,
          "events": [
            "download.complete"
          ],
          "name": "Gotify",
          "settings": {
            "secretsSet": [
              "token"
            ],
            "url": "https://gotify.example.test/"
          },
          "type": "gotify"
        },
        "status": 201
      },
