        },
        "status": 400
      },
      "method": "POST",
      "multipart": {
        "content": "MZ",
        "contentType": "application/octet-stream",
        "fields": {
          "mediaFileId": "101"
        },
        "filename": "x.exe"
      },
      "path": "/api/media/101/subtitles/upload"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "File holds no subtitle cues",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "multipart": {
        "content": "no cues here",
        "contentType": "application/octet-stream",
        "fields": {
          "mediaFileId": "101"
        },
        "filename": "x.srt"
      },
      "path": "/api/media/101/subtitles/upload"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "MediaFile #999 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "POST",
      "multipart": {
        "content": "1\n00:00:01,000 --> 00:00:03,000\nHello there.\n\n2\n00:00:04,000 --> 00:00:06,000\nSecond line.\n",
        "contentType": "application/octet-stream",
        "fields": {
          "mediaFileId": "999"
        },
        "filename": "x.srt"
      },
      "path": "/api/media/101/subtitles/upload"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Invalid subtitle language \"a/b\"",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "multipart": {
        "content": "1\n00:00:01,000 --> 00:00:03,000\nHello there.\n\n2\n00:00:04,000 --> 00:00:06,000\nSecond line.\n",
        "contentType": "application/octet-stream",
        "fields": {
          "language": "a/b",
          "mediaFileId": "101"
        },
