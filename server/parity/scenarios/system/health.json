{
  "ignore": [
    "$..uptimeSeconds",
    "$..restartSupervisor",
    "$..version"
  ],
  "name": "system-health",
  "seed": "base",
  "steps": [
    {
      "as": "admin",
      "expect": {
        "body": {
          "database": {
            "name": "PostgreSQL",
            "ok": true
          },
          "installedPlugins": 10,
          "runningPlugins": 10
        },
        "status": 200
      },
      "method": "GET",
      "path": "/api/system/health"
    }
  ]
}
