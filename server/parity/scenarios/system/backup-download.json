{
  "capture": {
    "fname": "$.steps[0].body.filename"
  },
  "deviation": null,
  "ignore": [
    "$..filename",
    "$..size"
  ],
  "name": "system-backup-download",
  "seed": "base",
  "steps": [
    {
      "as": "admin",
      "expect": {
        "body": {},
        "status": 201
      },
      "method": "POST",
      "path": "/api/system/backup"
    },
    {
      "as": "admin",
      "expect": {
        "headers": {
          "accept-ranges": "bytes",
          "cache-control": "public, max-age=0",
          "content-type": "application/sql"
        },
        "status": 200
      },
      "method": "HEAD",
      "path": "/api/system/backups/{fname}"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "ok": true
        },
        "status": 200
      },
      "method": "DELETE",
      "path": "/api/system/backups/{fname}"
    }
  ],
  "strictMessage": true
}
