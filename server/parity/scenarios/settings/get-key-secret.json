{
  "deviation": "F5",
  "name": "settings-get-key-secret",
  "seed": "base",
  "steps": [
    {
      "as": "admin",
      "body": {
        "data": {
          "seerr_api_key": "s3cret",
          "visible_key": "v"
        }
      },
      "expect": {
        "body": {
          "ok": true
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/settings"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "key": "seerr_api_key",
          "secretSet": true,
          "value": null
        },
        "status": 200
      },
      "method": "GET",
      "path": "/api/settings/seerr_api_key"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "key": "visible_key",
          "value": "v"
        },
        "status": 200
      },
      "method": "GET",
      "path": "/api/settings/visible_key"
    }
  ]
}
