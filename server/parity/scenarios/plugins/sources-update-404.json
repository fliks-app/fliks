{
  "name": "plugins-sources-update-404",
  "seed": "base",
  "steps": [
    {
      "as": "admin",
      "body": {
        "enabled": false
      },
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Plugin source #999 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "PUT",
      "path": "/api/plugins/sources/999"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Plugin source #999 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "DELETE",
      "path": "/api/plugins/sources/999"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Plugin source #999 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "POST",
      "path": "/api/plugins/sources/999/refresh"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Plugin source #999 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "GET",
      "path": "/api/plugins/sources/999/catalog"
    },
    {
      "as": "admin",
      "body": {
        "enabled": false
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Validation failed (numeric string is expected)",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PUT",
      "path": "/api/plugins/sources/abc"
    }
  ]
}
