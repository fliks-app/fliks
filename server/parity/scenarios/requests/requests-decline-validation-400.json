{
  "deviation": null,
  "ignore": [
    "$..createdAt",
    "$..updatedAt"
  ],
  "name": "requests-decline-validation-400",
  "seed": "requests",
  "steps": [
    {
      "as": "admin",
      "body": {
        "reason": 5
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "reason must be shorter than or equal to 2000 characters",
            "reason must be a string"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/requests/1/decline"
    },
    {
      "as": "admin",
      "body": {
        "reason": ""
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "reason must be shorter than or equal to 2000 characters"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/requests/1/decline"
    },
    {
      "as": "admin",
      "body": {
        "extra": 1
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "property extra should not exist"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/requests/1/decline"
    }
  ]
}
