{
  "ignore": [
    "$..createdAt",
    "$..updatedAt"
  ],
  "name": "requests-create-validation-400",
  "seed": "requests",
  "steps": [
    {
      "as": "user",
      "body": {},
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "mediaType must be one of the following values: movie, series, book",
            "tmdbId must not be less than 1",
            "tmdbId must be an integer number",
            "title must be a string"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/requests"
    },
    {
      "as": "user",
      "body": {
        "extra": 1,
        "mediaType": "x",
        "seasons": [
          "a",
          1.5
        ],
        "title": 3,
        "tmdbId": "5"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "property extra should not exist",
            "mediaType must be one of the following values: movie, series, book",
            "tmdbId must not be less than 1",
            "tmdbId must be an integer number",
            "title must be a string",
            "each value in seasons must be an integer number"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/requests"
    },
    {
      "as": "user",
      "body": {
        "mediaType": "movie",
        "title": "t",
        "tmdbId": 0
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "tmdbId must not be less than 1"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/requests"
    }
  ]
}
