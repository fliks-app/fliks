{
  "ignore": [
    "$..createdAt",
    "$..updatedAt"
  ],
  "name": "requests-update-validation-400",
  "seed": "requests",
  "steps": [
    {
      "as": "user",
      "body": {
        "extra": 1,
        "qualityProfileId": "x"
      },
      "expect": {
