{
  "deviation": null,
  "ignore": [
    "$..createdAt",
    "$..updatedAt"
  ],
  "name": "requests-get-404",
  "seed": "requests",
  "steps": [
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Request #999 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "GET",
      "path": "/api/requests/999"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Validation failed (numeric string is expected)",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "GET",
      "path": "/api/requests/abc"
    }
  ]
}
