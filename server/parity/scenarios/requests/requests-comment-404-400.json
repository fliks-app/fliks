{
  "ignore": [
    "$..createdAt",
    "$..updatedAt"
  ],
  "name": "requests-comment-404-400",
  "seed": "requests",
  "steps": [
    {
      "as": "user",
      "body": {
        "message": "x"
      },
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Request #999 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "POST",
      "path": "/api/requests/999/comments"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Request #999 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "GET",
      "path": "/api/requests/999/comments"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Comment #999 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "DELETE",
      "path": "/api/requests/comments/999"
    },
    {
      "as": "user",
      "body": {
        "message": ""
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "message must be longer than or equal to 1 characters"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/requests/1/comments"
    },
    {
      "as": "user",
      "body": {},
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "message must be longer than or equal to 1 characters",
            "message must be a string"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/requests/1/comments"
    }
  ]
}
