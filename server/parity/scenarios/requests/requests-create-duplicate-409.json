{
  "deviation": null,
  "ignore": [
    "$..createdAt",
    "$..updatedAt"
  ],
  "name": "requests-create-duplicate-409",
  "seed": "requests",
  "steps": [
    {
      "as": "user",
      "body": {
        "mediaType": "movie",
        "title": "Again",
        "tmdbId": 9001
      },
      "expect": {
        "body": {
          "error": "Conflict",
          "message": "This title has already been requested",
          "statusCode": 409
        },
        "status": 409
      },
      "method": "POST",
      "path": "/api/requests"
    },
    {
      "as": "admin",
      "body": {
        "mediaType": "movie",
        "title": "Available",
        "tmdbId": 1001
      },
      "expect": {
        "body": {
          "error": "Conflict",
          "message": "This title has already been requested",
          "statusCode": 409
        },
        "status": 409
      },
      "method": "POST",
      "path": "/api/requests"
    }
  ]
}
