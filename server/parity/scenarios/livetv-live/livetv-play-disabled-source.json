{
  "capture": {
    "url": "$.steps[3].body.url"
  },
  "deviation": "C136",
  "engine": "up",
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..lastSyncAt",
    "$..logoPath",
    "$..sessionId",
    "$..url"
  ],
  "name": "livetv-play-disabled-source",
  "seed": "livetv-live",
  "steps": [
    {
      "as": "admin",
      "body": {
        "value": "2"
      },
      "expect": {
        "body": {
          "id": 5,
          "key": "livetv_channel_idle_seconds",
          "value": "2"
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/settings/livetv_channel_idle_seconds"
    },
    {
      "as": "admin",
      "body": {
        "value": "1"
      },
      "expect": {
        "body": {
          "id": 6,
          "key": "livetv_slot_release_seconds",
          "value": "1"
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/settings/livetv_slot_release_seconds"
    },
    {
      "as": "user",
      "body": {},
      "expect": {
        "body": {
          "channelName": "G",
          "code": "livetv_channel_unavailable"
        },
        "status": 503
      },
      "method": "POST",
      "path": "/api/livetv/channels/8/play"
    },
    {
      "as": "user",
      "body": {},
      "expect": {
        "body": {
          "channelId": 5,
          "channelName": "E",
          "dvrWindowSeconds": 900,
          "isLive": true,
          "mode": "remux",
          "segmentSeconds": 2
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/livetv/channels/5/play"
    },
    {
      "as": "admin",
      "body": {
        "enabled": false
      },
      "expect": {
        "body": {
          "accountStatus": null,
          "channelCount": 0,
          "enabled": false,
          "excludeGroupsPattern": null,
          "expiresAt": null,
          "guideUrls": [],
          "id": 2,
          "includeGroupsPattern": null,
          "kind": "m3u",
          "lastAdultGuardError": null,
          "lastSyncError": null,
          "lastSyncStatus": "ok",
          "maxStreams": 0,
          "maxStreamsIsManual": false,
          "name": "S2",
          "playlistEtag": null,
          "playlistLastModified": null,
          "priority": 1,
          "referer": null,
          "refreshIntervalHours": 12,
          "userAgent": null,
          "username": null
        },
        "status": 200
      },
      "method": "PATCH",
      "path": "/api/livetv/admin/sources/2"
    },
    {
      "as": "anon",
      "expect": {
        "status": 200
      },
      "method": "GET",
      "path": "/",
      "sleepMs": 800
    },
    {
      "as": "anon",
      "baseEnv": "PARITY_FRONT",
      "expect": {
        "status": 403
      },
      "ignoreBody": true,
      "method": "GET",
      "path": "{url}"
    },
    {
      "as": "user",
      "body": {},
      "expect": {
        "body": {
          "channelName": "E",
          "code": "livetv_channel_unavailable"
        },
        "status": 503
      },
      "method": "POST",
      "path": "/api/livetv/channels/5/play"
    }
  ]
}
