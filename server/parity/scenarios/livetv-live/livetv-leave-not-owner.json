{
  "capture": {
    "sid": "$.steps[2].body.sessionId"
  },
  "engine": "up",
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..lastSyncAt",
    "$..logoPath",
    "$..sessionId",
    "$..url"
  ],
  "name": "livetv-leave-not-owner",
  "seed": "livetv-live",
  "steps": [
    {
      "as": "admin",
      "body": {
        "value": "2"
      },
      "expect": {
        "body": {
          "id": 5,
          "key": "livetv_channel_idle_seconds",
          "value": "2"
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/settings/livetv_channel_idle_seconds"
    },
    {
      "as": "admin",
      "body": {
        "value": "1"
      },
      "expect": {
        "body": {
          "id": 6,
          "key": "livetv_slot_release_seconds",
          "value": "1"
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/settings/livetv_slot_release_seconds"
    },
    {
      "as": "user",
      "body": {},
      "expect": {
        "body": {
          "channelId": 5,
          "channelName": "E",
          "dvrWindowSeconds": 900,
          "isLive": true,
          "mode": "remux",
          "segmentSeconds": 2
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/livetv/channels/5/play"
    },
    {
      "as": "other",
      "expect": {
        "body": {
          "error": "Forbidden",
          "message": "Not your session",
          "statusCode": 403
        },
        "status": 403
      },
      "method": "DELETE",
      "path": "/api/livetv/sessions/{sid}"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "ok": true
        },
        "status": 200
      },
      "method": "DELETE",
      "path": "/api/livetv/sessions/{sid}"
    }
  ]
}
