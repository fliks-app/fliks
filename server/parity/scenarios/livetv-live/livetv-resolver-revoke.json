{
  "capture": {
    "sid": "$.steps[2].body.sessionId",
    "url": "$.steps[2].body.url"
  },
  "engine": "up",
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..lastSyncAt",
    "$..logoPath",
    "$..sessionId",
    "$..url"
  ],
  "name": "livetv-resolver-revoke",
  "seed": "livetv-live",
  "steps": [
    {
      "as": "admin",
      "body": {
        "value": "2"
      },
      "expect": {
        "body": {
          "id": 5,
          "key": "livetv_channel_idle_seconds",
          "value": "2"
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/settings/livetv_channel_idle_seconds"
    },
    {
      "as": "admin",
      "body": {
        "value": "1"
      },
      "expect": {
        "body": {
          "id": 6,
          "key": "livetv_slot_release_seconds",
          "value": "1"
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/settings/livetv_slot_release_seconds"
    },
    {
      "as": "other",
      "body": {},
      "expect": {
        "body": {
          "channelId": 6,
          "channelName": "R",
          "dvrWindowSeconds": 900,
          "isLive": true,
          "mode": "remux",
          "segmentSeconds": 2
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/livetv/channels/6/play"
    },
    {
      "as": "admin",
      "body": {
        "groups": []
      },
      "expect": {
        "body": {
          "groups": [],
          "ignored": []
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/livetv/admin/access/users/4"
    },
    {
      "as": "anon",
      "wait": "idle",
      "expect": {
        "status": 200
      }
    },
    {
      "as": "anon",
      "baseEnv": "PARITY_FRONT",
      "expect": {
        "status": 404
      },
      "ignoreBody": true,
      "method": "GET",
      "path": "{url}",
      "retryMs": 10000
    }
  ]
}
