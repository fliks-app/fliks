{
  "capture": {
    "sid": "$.steps[3].body.sessionId",
    "sid2": "$.steps[5].body.sessionId"
  },
  "deviation": null,
  "engine": "up",
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..lastSyncAt",
    "$..logoPath",
    "$..sessionId",
    "$..url"
  ],
  "name": "livetv-play-restricted-404",
  "seed": "livetv-live",
  "steps": [
    {
      "as": "admin",
      "body": {
        "value": "2"
      },
      "expect": {
        "body": {
          "id": 5,
          "key": "livetv_channel_idle_seconds",
          "value": "2"
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/settings/livetv_channel_idle_seconds"
    },
    {
      "as": "admin",
      "body": {
        "value": "1"
      },
      "expect": {
        "body": {
          "id": 6,
          "key": "livetv_slot_release_seconds",
          "value": "1"
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/settings/livetv_slot_release_seconds"
    },
    {
      "as": "user",
      "body": {},
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Live TV channel #6 not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "POST",
      "path": "/api/livetv/channels/6/play"
    },
    {
      "as": "other",
      "body": {},
      "expect": {
        "body": {
          "channelId": 6,
          "channelName": "R",
          "dvrWindowSeconds": 900,
          "isLive": true,
          "mode": "remux",
          "segmentSeconds": 2
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/livetv/channels/6/play"
    },
    {
      "as": "other",
      "expect": {
        "body": {
          "ok": true
        },
        "status": 200
      },
      "method": "DELETE",
      "path": "/api/livetv/sessions/{sid}"
    },
    {
      "as": "admin",
      "body": {},
      "expect": {
        "body": {
          "channelId": 6,
          "channelName": "R",
          "dvrWindowSeconds": 900,
          "isLive": true,
          "mode": "remux",
          "segmentSeconds": 2
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/livetv/channels/6/play"
    },
    {
      "as": "admin",
      "expect": {
        "body": {
          "ok": true
        },
        "status": 200
      },
      "method": "DELETE",
      "path": "/api/livetv/sessions/{sid2}"
    }
  ]
}
