{
  "capture": {
    "sid1": "$.steps[2].body.sessionId",
    "sid3": "$.steps[4].body.sessionId",
    "sid4": "$.steps[8].body.sessionId"
  },
  "deviation": null,
  "engine": "up",
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..lastSyncAt",
    "$..logoPath",
    "$..sessionId",
    "$..url"
  ],
  "name": "livetv-capacity-409",
  "seed": "livetv-live",
  "steps": [
    {
      "as": "admin",
      "body": {
        "value": "2"
      },
      "expect": {
        "body": {
          "id": 5,
          "key": "livetv_channel_idle_seconds",
          "value": "2"
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/settings/livetv_channel_idle_seconds"
    },
    {
      "as": "admin",
      "body": {
        "value": "1"
      },
      "expect": {
        "body": {
          "id": 6,
          "key": "livetv_slot_release_seconds",
          "value": "1"
        },
        "status": 200
      },
      "method": "PUT",
      "path": "/api/settings/livetv_slot_release_seconds"
    },
    {
      "as": "user",
      "body": {},
      "expect": {
        "body": {
          "channelId": 1,
          "channelName": "A",
          "dvrWindowSeconds": 900,
          "isLive": true,
          "mode": "remux",
          "segmentSeconds": 2
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/livetv/channels/1/play"
    },
    {
      "as": "user",
      "body": {},
      "expect": {
        "body": {
          "code": "livetv_source_at_capacity",
          "limit": 1,
          "sourceName": "S1"
        },
        "status": 409
      },
      "method": "POST",
      "path": "/api/livetv/channels/2/play"
    },
    {
      "as": "other",
      "body": {},
      "expect": {
        "body": {
          "channelId": 1,
          "channelName": "A",
          "dvrWindowSeconds": 900,
          "isLive": true,
          "mode": "remux",
          "segmentSeconds": 2
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/livetv/channels/1/play"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "ok": true
        },
        "status": 200
      },
      "method": "DELETE",
      "path": "/api/livetv/sessions/{sid1}"
    },
    {
      "as": "other",
      "expect": {
        "body": {
          "ok": true
        },
        "status": 200
      },
      "method": "DELETE",
      "path": "/api/livetv/sessions/{sid3}"
    },
    {
      "as": "anon",
      "expect": {
        "status": 200
      },
      "method": "GET",
      "path": "/",
      "sleepMs": 4500,
      "note": "release grace: livetv_channel_idle_seconds 2 s + livetv_slot_release_seconds 1 s, plus a 1.5 s margin"
    },
    {
      "as": "user",
      "body": {},
      "expect": {
        "body": {
          "channelId": 2,
          "channelName": "B",
          "dvrWindowSeconds": 900,
          "isLive": true,
          "mode": "remux",
          "segmentSeconds": 2
        },
        "status": 201
      },
      "method": "POST",
      "path": "/api/livetv/channels/2/play"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "ok": true
        },
        "status": 200
      },
      "method": "DELETE",
      "path": "/api/livetv/sessions/{sid4}"
    }
  ]
}
