            "accessible": true
          },
          "folders": [
            {
              "disk": {
                "accessible": true
              },
              "id": 2,
              "mediaCount": 3,
              "path": "/tmp/fliks-parity/media/series",
              "position": 0
            }
          ],
          "icon": "tv",
          "id": 2,
          "label": null,
          "mediaTypes": [
            "series"
          ],
          "metadataLanguage": null,
          "metadataRegion": null,
          "name": "Series",
          "path": "/tmp/fliks-parity/media/series",
          "preferredProvider": null,
          "userIds": [
            2,
            4,
            5
          ]
        },
        "status": 200
      },
      "method": "GET",
      "path": "/api/libraries/2"
    }
  ],
  "strictMessage": true
}
