      "method": "GET",
      "path": "/api/libraries/2"
    },
    {
      "as": "user",
      "expect": {
        "body": [
          {
            "color": "#3b82f6",
            "defaultLanguageProfileId": null,
            "defaultQualityProfileId": null,
            "folders": [
              {
                "id": 1,
                "name": "movies"
              }
            ],
            "icon": "film",
            "id": 1,
            "mediaTypes": [
              "movie"
            ],
            "name": "Movies"
          }
        ],
        "status": 200
      },
      "method": "GET",
      "path": "/api/libraries/mine"
    }
  ]
}
