{
  "ignore": [
    "$..createdAt",
    "$..updatedAt",
    "$..freeSpace",
    "$..totalSpace"
  ],
  "name": "libraries-delete",
  "seed": "base",
  "steps": [
    {
      "as": "admin",
      "expect": {
        "status": 200
      },
      "method": "DELETE",
      "path": "/api/libraries/2"
    },
    {
      "as": "admin",
