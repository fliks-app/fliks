{
  "capture": {
    "st": "$.steps[0].body.streamToken"
  },
  "ignore": [
    "$..streamToken",
    "$..expiresAt"
  ],
  "name": "qoe-events-stream-token-forbidden",
  "seed": "base",
  "steps": [
    {
      "as": "user",
      "expect": {
        "body": {},
        "status": 201
      },
      "method": "POST",
      "path": "/api/auth/stream-token"
    },
    {
      "as": "anon",
      "body": {
        "events": [
          {
            "at": 1,
            "type": "play"
          }
        ],
        "playbackId": "p1",
        "sentAt": 1
      },
      "expect": {
        "body": {
          "error": "Forbidden",
          "message": "session_token_required",
          "statusCode": 403
        },
        "status": 403
      },
      "headers": {
        "Authorization": "Bearer {st}"
      },
      "method": "POST",
      "path": "/api/playback/sessions/nosuch/events"
    }
  ]
}
