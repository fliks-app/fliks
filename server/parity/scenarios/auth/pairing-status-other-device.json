{
  "capture": {
    "pid": "$.steps[0].body.pairingId"
  },
  "ignore": [
    "$..pairingId"
  ],
  "name": "auth-pairing-status-other-device",
  "seed": "base",
  "steps": [
    {
      "as": "anon",
      "body": {
        "deviceName": "Living room TV",
        "systemName": "tvOS",
        "userId": 2
      },
      "expect": {
        "body": {
          "expiresIn": 600
        },
        "status": 201
      },
      "headers": {
        "X-Device-Id": "dev-1"
      },
      "method": "POST",
      "path": "/api/auth/pairing/request"
    },
    {
      "as": "anon",
      "expect": {
        "body": {
          "status": "pending"
        },
        "status": 200
      },
      "headers": {
        "X-Device-Id": "dev-2"
      },
      "method": "GET",
      "path": "/api/auth/pairing/status?pairingId={pid}"
    }
  ]
}
