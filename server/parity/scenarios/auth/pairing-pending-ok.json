{
  "ignore": [
    "$..pairingId",
    "$..requestedAt",
    "$..expiresAt"
  ],
  "name": "auth-pairing-pending-ok",
  "seed": "base",
  "steps": [
    {
      "as": "anon",
      "body": {
        "deviceName": "Living room TV",
        "systemName": "tvOS",
        "userId": 2
      },
      "expect": {
        "body": {
          "expiresIn": 600
        },
        "status": 201
      },
      "headers": {
        "X-Device-Id": "dev-1"
      },
      "method": "POST",
      "path": "/api/auth/pairing/request"
    },
    {
      "as": "user",
      "expect": {
        "body": [
          {
            "deviceId": "dev-1",
            "deviceName": "Living room TV",
            "systemName": "tvOS"
          }
        ],
        "status": 200
      },
      "method": "GET",
      "path": "/api/auth/pairing/pending"
    }
  ]
}
