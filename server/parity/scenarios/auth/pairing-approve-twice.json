{
  "capture": {
    "pid": "$.steps[0].body.pairingId"
  },
  "deviation": null,
  "ignore": [
    "$..pairingId"
  ],
  "name": "auth-pairing-approve-twice",
  "seed": "base",
  "steps": [
    {
      "as": "anon",
      "body": {
        "deviceName": "Living room TV",
        "systemName": "tvOS",
        "userId": 2
      },
      "expect": {
        "body": {
          "expiresIn": 600
        },
        "status": 201
      },
      "headers": {
        "X-Device-Id": "dev-1"
      },
      "method": "POST",
      "path": "/api/auth/pairing/request"
    },
    {
      "as": "user",
      "expect": {
        "status": 204
      },
      "method": "POST",
      "path": "/api/auth/pairing/{pid}/approve"
    },
    {
      "as": "user",
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Cannot approve a approved request",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/auth/pairing/{pid}/approve"
    }
  ]
}
