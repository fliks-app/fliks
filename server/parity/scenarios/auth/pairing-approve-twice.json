{
  "capture": {
    "code": "$.steps[0].body.code"
  },
  "ignore": [
    "$..pairingId",
    "$..code"
  ],
  "name": "auth-pairing-approve-twice",
  "seed": "base",
  "steps": [
    {
      "as": "anon",
      "body": {
        "deviceName": "Living room TV",
        "systemName": "tvOS",
        "userId": 2
      },
      "expect": {
        "body": {
          "expiresIn": 600
        },
        "status": 201
      },
      "headers": {
        "X-Device-Id": "dev-1"
      },
      "method": "POST",
      "path": "/api/auth/pairing/request"
    },
    {
      "as": "user",
      "body": {
        "code": "{code}"
      },
      "expect": {
        "status": 204
      },
      "method": "POST",
      "path": "/api/auth/pairing/approve"
    },
    {
      "as": "user",
      "body": {
        "code": "{code}"
      },
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "No pending request with this code",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "POST",
      "path": "/api/auth/pairing/approve"
    }
  ]
}
