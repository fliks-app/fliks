{
  "capture": {
    "pid": "$.steps[0].body.pairingId"
  },
  "ignore": [
    "$..pairingId"
  ],
  "name": "auth-pairing-deny-other-user",
  "seed": "base",
  "steps": [
    {
      "as": "anon",
      "body": {
        "deviceName": "Living room TV",
        "systemName": "tvOS",
        "userId": 2
      },
      "expect": {
        "body": {
          "expiresIn": 600
        },
        "status": 201
      },
      "headers": {
        "X-Device-Id": "dev-1"
      },
      "method": "POST",
      "path": "/api/auth/pairing/request"
    },
    {
      "as": "other",
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "Pairing request not found",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "POST",
      "path": "/api/auth/pairing/{pid}/deny"
    }
  ]
}
