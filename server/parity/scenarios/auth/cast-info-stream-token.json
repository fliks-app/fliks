{
  "capture": {
    "st": "$.steps[0].body.streamToken"
  },
  "ignore": [
    "$.streamToken",
    "$.expiresAt",
    "$.token",
    "$.streamBaseUrl"
  ],
  "name": "auth-cast-info-stream-token",
  "seed": "base",
  "steps": [
    {
      "as": "user",
      "expect": {
        "body": {},
        "status": 201
      },
      "method": "POST",
      "path": "/api/auth/stream-token"
    },
    {
      "as": "anon",
      "expect": {
        "body": {
          "message": "Unauthorized",
          "statusCode": 401
        },
        "status": 401
      },
      "headers": {
        "Authorization": "Bearer {st}"
      },
      "method": "POST",
      "path": "/api/auth/cast-info"
    }
  ]
}
