{
  "capture": {
    "code": "$.steps[0].body.code",
    "pid": "$.steps[0].body.pairingId"
  },
  "ignore": [
    "$..pairingId",
    "$..accessToken",
    "$..refreshToken",
    "$..accessTokenExpiresAt",
    "$..refreshTokenExpiresAt",
    "$..createdAt",
    "$..updatedAt",
    "$..code"
  ],
  "name": "auth-pairing-approve-ok",
  "seed": "base",
  "steps": [
    {
      "as": "anon",
      "body": {
        "deviceName": "Living room TV",
        "systemName": "tvOS",
        "userId": 2
      },
      "expect": {
        "body": {
          "expiresIn": 600
        },
        "status": 201
      },
      "headers": {
        "X-Device-Id": "dev-1"
      },
      "method": "POST",
      "path": "/api/auth/pairing/request"
    },
    {
      "as": "user",
      "body": {
        "code": "{code}"
      },
      "expect": {
        "status": 204
      },
      "method": "POST",
      "path": "/api/auth/pairing/approve"
    },
    {
      "as": "anon",
      "expect": {
        "body": {
          "status": "approved"
        },
        "status": 200
      },
      "headers": {
        "X-Device-Id": "dev-1"
      },
      "method": "GET",
      "path": "/api/auth/pairing/status?pairingId={pid}"
    },
    {
      "as": "anon",
      "expect": {
        "body": {
          "status": "approved"
        },
        "status": 200
      },
      "headers": {
        "X-Device-Id": "dev-1"
      },
      "method": "GET",
      "path": "/api/auth/pairing/status?pairingId={pid}"
    }
  ]
}
