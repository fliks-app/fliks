{
  "capture": {
    "code": "$.steps[0].body.code",
    "pid": "$.steps[0].body.pairingId"
  },
  "ignore": [
    "$..code",
    "$..pairingId"
  ],
  "name": "auth-pairing-lookup-other-user",
  "seed": "base",
  "steps": [
    {
      "as": "anon",
      "body": {
        "deviceName": "Living room TV",
        "systemName": "tvOS",
        "userId": 2
      },
      "expect": {
        "body": {
          "expiresIn": 600
        },
        "status": 201
      },
      "headers": {
        "X-Device-Id": "dev-1"
      },
      "method": "POST",
      "path": "/api/auth/pairing/request"
    },
    {
      "as": "other",
      "body": {
        "code": "{code}"
      },
      "expect": {
        "body": {
          "error": "Not Found",
          "message": "No pending request with this code",
          "statusCode": 404
        },
        "status": 404
      },
      "method": "POST",
      "path": "/api/auth/pairing/lookup"
    }
  ]
}
