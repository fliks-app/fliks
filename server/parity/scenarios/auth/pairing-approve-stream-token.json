{
  "capture": {
    "pid": "$.steps[1].body.pairingId",
    "st": "$.steps[0].body.streamToken"
  },
  "deviation": "F8",
  "ignore": [
    "$.streamToken",
    "$.expiresAt",
    "$..pairingId"
  ],
  "name": "auth-pairing-approve-stream-token",
  "seed": "base",
  "steps": [
    {
      "as": "user",
      "expect": {
        "body": {},
        "status": 201
      },
      "method": "POST",
      "path": "/api/auth/stream-token"
    },
    {
      "as": "anon",
      "body": {
        "deviceName": "TV",
        "userId": 2
      },
      "expect": {
        "body": {
          "expiresIn": 600
        },
        "status": 201
      },
      "headers": {
        "X-Device-Id": "dev-1"
      },
      "method": "POST",
      "path": "/api/auth/pairing/request"
    },
    {
      "as": "anon",
      "expect": {
        "body": {
          "message": "Unauthorized",
          "statusCode": 401
        },
        "status": 401
      },
      "headers": {
        "Authorization": "Bearer {st}"
      },
      "method": "POST",
      "path": "/api/auth/pairing/{pid}/approve"
    }
  ]
}
