{
  "ignore": [
    "$..createdAt",
    "$..updatedAt"
  ],
  "name": "profiles-language-validation-400",
  "seed": "profiles",
  "steps": [
    {
      "as": "admin",
      "body": {
        "name": "x",
        "subtitleLanguages": [
          {
            "forced": false,
            "hearingImpaired": "maybe",
            "hi": false,
            "isoCode": "a",
            "name": "A"
          }
        ]
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "subtitleLanguages.0.hearingImpaired must be one of the following values: prefer, avoid, require, forbid"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/profiles/language"
    },
    {
      "as": "admin",
      "body": {
        "name": "x",
        "subtitleLanguages": [
          {
            "hi": false,
            "isoCode": "a",
            "name": "A"
          }
        ]
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "subtitleLanguages.0.forced must be a boolean value"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/profiles/language"
    },
    {
      "as": "admin",
      "body": {
        "audioLanguages": [
          {
            "isoCode": "a",
            "name": "A",
            "z": 1
          }
        ],
        "name": "x"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "audioLanguages.0.property z should not exist"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/profiles/language"
    },
    {
      "as": "admin",
      "body": {
        "audioLanguages": "en",
        "name": "x"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "audioLanguages must be an array",
            "each value in nested property audioLanguages must be either object or array"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/profiles/language"
    },
    {
      "as": "admin",
      "body": {},
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "name must be a string"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/profiles/language"
    },
    {
      "as": "admin",
      "body": {
        "name": 5
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": [
            "name must be a string"
          ],
          "statusCode": 400
        },
        "status": 400
      },
      "method": "POST",
      "path": "/api/profiles/language"
    }
  ]
}
