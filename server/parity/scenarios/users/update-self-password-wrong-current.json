{
  "name": "users-update-self-password-wrong-current",
  "seed": "base",
  "steps": [
    {
      "as": "user",
      "body": {
        "currentPassword": "not-the-password",
        "password": "newpassword1"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Current password is incorrect",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PUT",
      "path": "/api/users/2"
    },
    {
      "as": "user",
      "body": {
        "password": "newpassword1"
      },
      "expect": {
        "body": {
          "error": "Bad Request",
          "message": "Current password is incorrect",
          "statusCode": 400
        },
        "status": 400
      },
      "method": "PUT",
      "path": "/api/users/2"
    }
  ]
}
