            "id": 3,
            "isAdmin": false,
            "libraryIds": [],
            "libraryOrder": [],
            "mediaServerId": null,
            "mediaServerType": "local",
            "movieQuotaLimit": 0,
            "permissions": [
              "media.read",
              "livetv.read"
            ],
            "profileVisibility": "private",
            "quotaPeriodDays": 7,
            "requirePasswordChange": false,
            "role": "Readonly",
            "roleId": 3,
            "seriesQuotaLimit": 0,
            "shareDisabled": false,
            "shareLikes": false,
