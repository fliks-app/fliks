            "id": 2,
            "isAdmin": false,
            "libraryIds": [],
            "libraryOrder": [],
            "mediaServerId": null,
            "mediaServerType": "local",
            "movieQuotaLimit": 0,
            "permissions": [
              "media.read",
              "livetv.read",
              "requests.create",
              "parties.create",
              "parties.read_public"
