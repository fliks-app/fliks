{
  "id": "org.example.anime",
  "pluginApi": 3,
  "name": "Example anime provider",
  "fliks": ">=5.0.0 <7.0.0",
  "author": "Fliks",
  "description": "Test fixture: a metadata provider with its own id namespace.",
  "license": "MIT",
  "logo": "logo.svg",
  "kind": "process",
  "runtime": "wasm",
  "memoryMb": 64,
  "database": { "schema": false, "coreRefs": [] },
  "scopes": [],
  "ingestRoots": [],
  "routes": [],
  "provider": {
    "namespaces": [
      { "name": "org.example.anime:aid", "label": "Example Anime DB", "idPattern": "^[1-9][0-9]{0,8}$", "case": "preserve" }
    ],
    "kinds": { "series": ["search", "work", "children", "findBy"] },
    "findBy": ["imdb", "tvdb"],
    "limits": { "ratePerSec": 1, "burst": 2 },
    "imageHosts": ["cdn.example.org"]
  }
}
