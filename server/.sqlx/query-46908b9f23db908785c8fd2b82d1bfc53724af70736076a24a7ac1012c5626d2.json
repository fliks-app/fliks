{
  "db_name": "PostgreSQL",
  "query": "SELECT (uf.\"followingId\" = $1) AS \"incoming!\", u.enabled, u.\"shareDisabled\" AS share_disabled\n           FROM user_follows uf\n           JOIN users u ON u.id = CASE WHEN uf.\"followingId\" = $1 THEN uf.\"followerId\" ELSE uf.\"followingId\" END\n           WHERE uf.status = 'accepted' AND (uf.\"followingId\" = $1 OR uf.\"followerId\" = $1)",
