{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "prerelease": true,
      "package-name": "fliks",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "client/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "client/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "client/package-lock.json",
          "jsonpath": "$.packages[''].version"
        },
        {
          "type": "json",
          "path": "desktop/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "desktop/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "desktop/package-lock.json",
          "jsonpath": "$.packages[''].version"
        },
        {
          "type": "json",
          "path": "client/webos/appinfo.json",
          "jsonpath": "$.version"
        },
        {
          "type": "xml",
          "path": "client/tizen/config.xml",
          "xpath": "//*[local-name()='widget']/@version"
        },
        {
          "type": "toml",
          "path": "server/Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "server/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='fliks-server')].version"
        },
        {
          "type": "toml",
          "path": "server/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='fliks_domain')].version"
        },
        {
          "type": "toml",
          "path": "server/crates/plugin-sdk/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='fliks-server')].version"
        },
        {
          "type": "toml",
          "path": "server/crates/plugin-sdk/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='fliks_domain')].version"
        },
        {
          "type": "generic",
          "path": "macos/Fliks/Info.plist"
        },
        "client/android/app/build.gradle",
        "client/src/environments/environment.ts",
        "cast-receiver/index.html",
        "client/ios/App/App.xcodeproj/project.pbxproj",
        "appletv/project.yml"
      ]
    }
  }
}
