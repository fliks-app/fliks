{
  "name": "client",
  "version": "7.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "ng": "ng",
    "cast-app-id": "node scripts/cast-app-id.mjs",
    "start": "npm run cast-app-id && ng serve",
    "start:docker": "npm run cast-app-id && ng serve --configuration docker --host 0.0.0.0 --port 4500 --poll 2000",
    "build": "ng build && node scripts/stage-licenses.mjs && node scripts/preload-closure.mjs && ngsw-config dist/client/browser ngsw-config.json && node scripts/check-ngsw.mjs",
    "build:dev": "npm run cast-app-id && ng build --configuration development",
    "watch": "npm run cast-app-id && ng build --watch --configuration development",
    "lint": "eslint src",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "test": "ng test",
    "cap:sync": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:build": "npm run build && npx cap sync android",
    "cap:build:ios": "npm run build && npx cap sync ios",
    "tizen:build": "BROWSERSLIST='chrome 76' ng build --configuration tizen && node scripts/stage-licenses.mjs && node tizen/build-wgt.mjs",
    "tizen:deploy": "sdb connect $TV_IP && sdb install dist/Fliks-$(node -p \"require('./package.json').version\").wgt",
    "tizen:build:deploy": "npm run tizen:build && npm run tizen:deploy",
    "webos:compile": "BROWSERSLIST='chrome 76' ng build --configuration webos && node scripts/stage-licenses.mjs",
    "webos:build": "npm run webos:compile && node webos/build-ipk.mjs"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@lucide/angular": "^1.76.0",
    "@lucide/icons": "^1.76.0",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "@readium/navigator": "2.15.0",
    "@readium/shared": "2.9.0",
    "@tailwindcss/postcss": "^4.3.5",
    "css-selector-generator": "3.9.5",
    "daisyui": "^5.8.1",
    "marked": "^18.2.1",
    "pdfjs-dist": "6.5.438",
    "postcss": "^8.5.33",
    "rxjs": "~7.8.0",
    "shaka-player": "~5.3.5",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@capacitor/cli": "^8.6.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.67.0",
    "angular-eslint": "^22.8.0",
    "emojibase-data": "^18.0.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "postcss-preset-env": "^11.6.3",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
