{
  "name": "client",
  "version": "5.1.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "ng": "ng",
    "cast-app-id": "node scripts/cast-app-id.mjs",
    "start": "npm run cast-app-id && ng serve",
    "start:docker": "npm run cast-app-id && ng serve --configuration docker --host 0.0.0.0 --port 4500 --poll 2000",
    "build": "ng build",
    "watch": "npm run cast-app-id && ng build --watch --configuration development",
    "test": "ng test",
    "cap:sync": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:build": "npm run build && npx cap sync android",
    "cap:build:ios": "npm run build && npx cap sync ios",
    "tizen:build": "BROWSERSLIST='chrome 85' ng build --configuration tizen && node tizen/build-wgt.mjs",
    "tizen:deploy": "sdb connect $TV_IP && sdb install dist/Fliks-$(node -p \"require('./package.json').version\").wgt",
    "tizen:build:deploy": "npm run tizen:build && npm run tizen:deploy",
    "webos:compile": "BROWSERSLIST='chrome 85' ng build --configuration webos",
    "webos:build": "npm run webos:compile && node webos/build-ipk.mjs"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@lucide/angular": "^1.61.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "daisyui": "^5.7.50",
    "marked": "^18.1.1",
    "postcss": "^8.5.31",
    "rxjs": "~7.8.0",
    "shaka-player": "~5.3.2",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@capacitor/cli": "^8.5.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@webos-tools/cli": "^3.2.6",
    "emojibase-data": "^18.0.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "postcss-preset-env": "^11.6.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
