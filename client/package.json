{
  "name": "client",
  "version": "3.7.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:docker": "ng serve --configuration docker --host 0.0.0.0 --port 4500 --poll 2000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cap:sync": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:build": "npm run build && npx cap sync android",
    "cap:build:ios": "npm run build && npx cap sync ios",
    "tizen:build": "BROWSERSLIST='chrome 85' ng build --configuration tizen && node tizen/build-wgt.mjs",
    "tizen:deploy": "sdb connect $TV_IP && sdb install dist/Fliks-$(node -p \"require('./package.json').version\").wgt",
    "tizen:build:deploy": "npm run tizen:build && npm run tizen:deploy",
    "webos:build": "BROWSERSLIST='chrome 85' ng build --configuration webos && node webos/build-ipk.mjs"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/service-worker": "^22.1.5",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@lucide/angular": "^1.41.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@tailwindcss/postcss": "^4.2.2",
    "daisyui": "^5.5.19",
    "marked": "^14.1.4",
    "postcss": "^8.5.8",
    "rxjs": "~7.8.0",
    "shaka-player": "^5.0.9",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@capacitor/cli": "^8.5.1",
    "@csstools/postcss-cascade-layers": "^6.0.0",
