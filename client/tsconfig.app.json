/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    // The plugin contract lives in backend/, outside this root.
    "rootDir": "..",
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      // NG8107 misfires under Angular 22's template `?.` typing: dropping the
      // operator where it points turns into a hard TS2532 instead.
      "checks": { "optionalChainNotNullable": "suppress" }
    }
  }
}
