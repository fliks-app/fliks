node_modules/
dist/
release/
# The Angular client the CI stages here (cp client/dist/... → web/) for
# electron-builder to ship at resources/web; a generated artifact, not source.
web/
vendor/
# …except the self-contained libmpv the compositor addon dlopen's. It's a
# prebuilt runtime dep (FFmpeg statically linked, hidden symbols) vendored into
# the repo so CI produces a working .deb without a separate fetch step.
!native/vendor/
native/vendor/*
!native/vendor/libmpv.so.2
*.log
